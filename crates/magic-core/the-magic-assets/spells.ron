    ),
    (
      id: "stonebinding",
      category: "Earth",
      confidence: Inferred,
      sigil: "earth",
      signs: [("bind", Around), ("solidification", Around)],
      effect: "Stops a thing moving and binds it into a single mass.",
    ),
    (
      id: "cartpuller",
      category: "Decorative",
      confidence: Canon,
      sigil: "horse",
      signs: [("pulling", Around)],
      effect: "Horse spells pull heavy loads - the wiki's own evidence that a
               decorative sigil can have practical use.",
      note: "Decorative sigils were retconned from signs in chapter 78, and
             they are not inert: they sculpt a spell into their shape, target
             other spells built from the same sigil, and restrict a spell to
