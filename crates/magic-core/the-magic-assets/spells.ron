// Known spell compositions — use these as COMPILER TEST FIXTURES.
//
// Each entry is a canon spell whose ingredient list is documented. If our
// compiler is correct, feeding it these components must produce the stated
// effect. This is the closest thing we have to a spec conformance suite.
//
// Only spells whose composition is actually documented are listed. Many
// canon spells have visible glyphs nobody has fully decoded; those are
// deliberately absent rather than guessed at.

(
  spells: [
    (
      id: "watershot_seal",
      category: "Water",
      sigil: "water",
      signs: [("column", Around)],
      effect: "Shoots a stream of water straight up from the seal, assuming
               all signs are of equivalent length.",
      // TEST: unequal sign lengths must bias the output direction
      test_note: "Canon states equal lengths give a vertical jet. Our
                  implementation must therefore make length a real input, and
                  unequal lengths must tilt the stream.",
      first_appearance: "First spell Coco learned; misfired and hit Agott.",
    ),
    (
      id: "pyreball_seal",
      category: "Fire",
      sigil: "fire",
      signs: [("levitation", Around)],
      effect: "Produces a ball of flame that levitates itself and any
               sufficiently light object directly above the seal.",
      test_note: "Same sign arrangement as watershot but a different sigil.
                  If our compiler produces structurally similar output for
                  both, sigil swapping works correctly.",
    ),
    (
      id: "wall_breaker_seal",
      category: "Earth",
      sigil: "earth",
      signs: [("crushing", Around)],
      effect: "Pulverises solid material.",
      test_note: "Its reverse is integration — see below. These two are the
                  canonical reversibility test pair.",
    ),
    (
      id: "integration",
      category: "Earth",
      sigil: "earth",
      signs: [("crushing", Around)],
      reversed_signs: ["crushing"],
      effect: "Reassembles pulverised material. Temporary.",
      test_note: "compile(wall_breaker) + compile(integration) drawn together
                  must cancel to zero net effect (canon rule R6).",
    ),
    (
      id: "floating_expansion",
      category: "Niche",
      sigil: None,
      signs: [("enlarge", Center), ("selection", Center), ("float", Around)],
      effect: "Grows the object the seal is drawn on.",
      test_note: "Differs from spell_of_reduction ONLY by window vs diamond
                  and by enlarge orientation. If our compiler can't
                  distinguish these two, the scope and orientation model is
                  broken.",
    ),
    (
      id: "spell_of_reduction",
      category: "Niche",
      sigil: None,
      signs: [("enlarge", Center), ("diamond", Center)],
      reversed_signs: ["enlarge"],
      effect: "Shrinks nearby objects, not the object it is drawn on.",
    ),
    (
      id: "water_bolt",
      category: "Water",
      sigil: "water",
      signs: [("bolt", Around), ("region", Around)],
      region_arrangement: AllSameSide,
      effect: "Fires water projectiles at dangerous speed in the direction
               the region signs point.",
    ),
    (
      id: "floating_drops",
      category: "Mixed",
      sigil: "water",
      signs: [("region", Around)],
      region_arrangement: Opposed,
      effect: "Water manifests only along the ring itself.",
      test_note: "The single best test of the region arrangement analyser.
                  Same sigil and sign type as water_bolt, completely
                  different output, decided purely by arrangement.",
    ),
    (
      id: "serpents_bed_of_sand",
      category: "Earth",
      sigil: None,
      signs: [("collection", Around), ("convergence", Around)],
      nested: true,
      effect: "Gathers sand and compacts it into a hard, rigid surface.",
      test_note: "A sigil-less spell with a sign in the centre — proves the
                  compiler must accept glyphs with no sigil at all.",
    ),
    (
      id: "boulder_stretch_rope",
      category: "Earth",
      sigil: "earth",
      signs: [("weave", SurroundsSigil)],
      effect: "Turns stone into a long flexible ribbon.",
      inventor: "Richeh — an in-story example of a witch inventing a new sign.",
    ),
    (
      id: "twinned_bottles",
      category: "Forbidden",
      sigil: None,
      signs: [("convergence", Around), ("region", Around)],
      sign_counts: {"convergence": 2, "region": 2},
      region_arrangement: AllInward,
      effect: "Teleports fluid between two bottles, keeping contents evenly
               split regardless of distance.",
      note: "Largely undeciphered — only the convergence and region signs are
             identified. All other signs in the glyph are unfamiliar.",
    ),
    (
      id: "snugstone_spell",
      category: "Fire",
      sigil: "fire",
      signs: [("radial", Around)],
      effect: "Gentle sustained warmth rather than flame.",
      test_note: "The damping test — same sigil as pyreball, radically lower
                  intensity, from one sign.",
    ),
    (
      id: "glowstone_path",
      category: "Light",
      sigil: "light",
      signs: [("levitation", Around)],
      split_across_objects: true,
      effect: "Glows only when stepped on — pressure presses the two halves
               of the seal together, completing the ring.",
      test_note: "THE split-spell fixture. compile(half_a + half_b joined)
                  must equal compile(whole), and compile(half_a) alone must
                  produce nothing (canon rules R2 and R3).",
    ),

    (
      id: "flamespout",
      category: "Fire",
      confidence: Inferred,
      sigil: "fire",
      signs: [("column", Around)],
      sign_counts: {"column": 4},
      effect: "Shoots a column of flame straight up from the seal, so long as
               the column signs are all the same length.",
      note: "The watershot arrangement with the fire sigil in place of water.
             Inferred, not canon - but it is the swap the wiki's own
             watershot/pyreball pairing is built on, and canon is explicit that
             equal column signs shoot straight up.",
      test_note: "The preset the panel places. Four equal columns must sum to
                  zero drift, and a zero-drift seal must fire upward rather
                  than in a ring.",
    ),

    (
      id: "water_orb",
      category: "Water",
      confidence: Inferred,
      sigil: "water",
      signs: [("levitation", Around)],
      sign_counts: {"levitation": 4},
      effect: "A water sigil surrounded by levitation signs: gravity is
               reduced and the water is held in suspension as a ball.",
      note: "Composition from the community spell simulator's own sample, and
             it agrees with what the wiki says levitation does - floats the
             target, often shaping it into a sphere when balanced. Inferred
             rather than canon: the arrangement is reconstructed, not quoted.",
      test_note: "Four equal levitation signs must sum to zero drift. Canon ties
                  the sphere to the seal being *balanced*, so an unbalanced one
                  should not produce one.",
    ),
    (
      id: "fire_shot",
      category: "Fire",
      confidence: Inferred,
      sigil: "fire",
      signs: [("column", Around), ("region", Around)],
      sign_counts: {"column": 3, "region": 3},
      region_arrangement: AllSameSide,
      effect: "Flame thrown the way the region signs point, rather than
               straight up.",
      note: "The watershot/water_bolt pair with fire in place of water. Region
             is what turns a fountain into a shot.",
    ),
    (
      id: "earth_wall",
      category: "Earth",
      confidence: Inferred,
      sigil: "earth",
      signs: [("collection", Around), ("convergence", Around), ("solidification", Around)],
      effect: "Gathers stone and sand and packs it rigid - the serpent's bed
               arrangement with an earth sigil driving it.",
    ),
    (
      id: "wind_gust",
      category: "Air",
      confidence: Inferred,
      sigil: "wind",
      signs: [("dispersion", Around), ("region", Around)],
      sign_counts: {"dispersion": 4},
      region_arrangement: AllSameSide,
      effect: "Moves the air that is there, outward and one way.",
      note: "Wind cannot create air (§3.2), so in a sealed room this does
             nothing at all - which is the point of having it beside
             aeriform_bubble.",
    ),
    (
      id: "lightfall",
      category: "Light",
      confidence: Inferred,
      sigil: "light",
      signs: [("levitation", Around), ("dispersion", Around)],
      effect: "Light held above the seal and spread - a lamp rather than a
               beam.",
    ),

    // ── More of what the source shows ─────────────────────────────────────
    //
    // Everything below is added so the panel can *name* a spell without a
    // traced rune. §2's rule still holds and is visible in every entry: where
    // the composition is documented it is written out, and where it is not the
    // entry carries `confidence: Unknown` and an empty sign list rather than a
    // plausible guess. A spell nobody has decoded is still worth naming — the
    // hole is the useful part.

    (
      id: "raincleaver",
      category: "Water",
      confidence: Canon,
      sigil: "water",
      signs: [("column", Around), ("convergence", Around), ("link", Around)],
      sign_counts: {"column": 4, "convergence": 4},
      effect: "Qifrey's cutting spell: many small identical seals linked
               together, each throwing a thin blade of water.",
      test_note: "The amplification fixture. Canon says linked identical seals
                  beat one large spell of the same area, so compile_all must
                  make n copies worth more than n.",
      inventor: "Qifrey.",
    ),
    (
      id: "brooms_wind_underfoot",
      category: "Air",
      confidence: Canon,
      sigil: "wind_underfoot",
      signs: [("stability", Around), ("levitation", Around)],
      sign_counts: {"stability": 2, "levitation": 2},
      effect: "Holds a solid object up in the air with something to stand on -
               how a broom carries a rider rather than merely floating.",
      note: "The mechanism is unclear in canon; only that this sigil supports
             solids suspended in air.",
    ),
    (
      id: "vortex",
      category: "Air",
      confidence: Inferred,
      sigil: "whorling_winds",
      signs: [("column", Around)],
      sign_counts: {"column": 3},
      effect: "Air turned through rotation, rising as a whirl.",
      note: "Whorling winds is three-sided, which the wiki notes may hint at a
             fire connection - heating the air the way a hot-air balloon does.
             That is a hint, not an established mechanism.",
      test_note: "Rotation comes from the sigil here and from sign tilt in
                  §2.4. Both are canon and they must not double-count.",
    ),
    (
      id: "aeriform_bubble",
      category: "Air",
      confidence: Inferred,
      sigil: "aeriforms",
      signs: [("orb", Around), ("envelopment", Around)],
      effect: "Makes air where there was none and holds it in a pocket -
               the breathable-bubble reading of a sigil that creates air but
               cannot move it.",
      test_note: "The conservation counterpart to windrider: aeriforms may
                  create, wind may not, and the simulation must treat the two
                  differently.",
    ),
    (
      id: "windrider",
      category: "Air",
      confidence: Inferred,
      sigil: "wind",
      signs: [("column", Around), ("region", Around)],
      sign_counts: {"column": 4},
      region_arrangement: AllSameSide,
      effect: "Moves the air that is already there, hard, in one direction.",
      test_note: "Wind cannot create air (§3.2). Cast in a sealed room this
                  must find nothing and do nothing.",
    ),
    (
      id: "memory_erasure",
      category: "Forbidden",
      confidence: Canon,
      sigil: "obliviation",
      signs: [],
      glaives: 3,
      effect: "Removes a memory. What obliviation actually does is not
               established; that it is drawn with glaives is.",
      note: "One of only two uses of glaives anyone has seen. The glaives
             decide how firmly the spell embeds itself in a body, which is why
             a memory spell needs them and a watershot does not.",
      test_note: "The glaive fixture: embedding must read non-zero here and
                  zero everywhere else.",
    ),
    (
      id: "slime_rendering",
      category: "Forbidden",
      confidence: Canon,
      sigil: None,
      signs: [],
      glaives: 2,
      effect: "The other spell glaives were seen on. Effect not established.",
      note: "Named with no composition, and that is the entry. §2: an honest
             hole beats a plausible guess.",
    ),
    (
      id: "doorway",
      category: "Niche",
      confidence: Unknown,
      sigil: "doorways",
      signs: [("windows", SurroundsSigil)],
      effect: "Connects two places. The doorways sigil likely names *which*
               place; windows is drawn as a second ring lining the seal.",
      note: "Both halves are uncertain. Doorways may have one variant per
             location, and nobody has enumerated them.",
    ),
    (
      id: "calling_stone",
      category: "Niche",
      confidence: Canon,
      sigil: "calling",
      signs: [("stillness", Around)],
      effect: "Repeats a recorded phrase, over and over.",
      note: "Called a sigil only in the Japanese text.",
    ),
    (
      id: "guidance_lure",
      category: "Niche",
      confidence: Canon,
      sigil: "guidance",
      signs: [("gathering", Around), ("crosshair", Around)],
      effect: "Attracts objects matching the parameters the rest of the seal
