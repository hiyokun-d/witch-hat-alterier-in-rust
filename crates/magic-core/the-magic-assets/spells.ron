      note: "Fan-named sigil.",
    ),
    (
      id: "lantern_light",
      category: "Light",
      confidence: Canon,
      sigil: "light",
      signs: [("dispersion", Around), ("stillness", Around)],
      effect: "Magic manifested as light, spread evenly and held in place.",
      test_note: "Light is a fire variant, so this and pyreball share a family
