    ),
    (
      id: "rainfall",
      category: "Water",
      confidence: Inferred,
      sigil: "water",
      signs: [("rain", SurroundsSigil), ("collection", Around)],
      effect: "Falls as rain over the area rather than shooting anywhere.",
      note: "Rain surrounds the central sigil rather than sitting beside it,
