    ),
    (
      id: "mistveil",
      category: "Water",
      confidence: Inferred,
      sigil: "water",
      signs: [("billow", Center), ("concealment", Around)],
      effect: "Water turned to a cloud that hides what is inside it.",
      note: "Composition inferred from two signs the wiki describes, not from
