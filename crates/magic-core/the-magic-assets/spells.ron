      note: "Fan-named sigil, and billow can stand in for a sigil on its own.",
    ),
    (
      id: "firework",
      category: "Fire",
      confidence: Unknown,
      sigil: "flickering_light",
      signs: [("bolt", Around), ("dispersion", Around)],
      effect: "Unknown. Coco's failed attempt produced a small firework, so
               the real effect is probably that, stable.",
      note: "Fan-named. The effect is inferred from a *failure*, which is as
             weak as evidence gets - recorded as Unknown for that reason.",
    ),
    (
      id: "lightning_throw",
      category: "Fire",
      confidence: Unknown,
      sigil: "lightning",
      signs: [("bolt", Around), ("region", Around)],
      region_arrangement: AllSameSide,
      effect: "Unknown. Likely creates and directs electricity, from the
