      test_note: "The only spell where the signs describe *what to look for*
                  rather than what to do. Nothing models that yet.",
    ),
    (
      id: "everlasting",
      category: "Time",
      confidence: Canon,
      sigil: "repetition",
      signs: [("selection", Center)],
      effect: "Continuously returns the thing it is drawn on to the state it
               held when the spell took hold, temperature included. Stops rot,
               repairs damage, makes soft things springy.",
      test_note: "The one canon effect that is a simulation rule outright.
                  Every parcel it raises must carry an anchor.",
    ),
    (
      id: "crystalize_seal",
      category: "Water",
      confidence: Unknown,
      sigil: "crystalize",
      signs: [("solidification", Around)],
      effect: "Turns air or water into crystal, or into ice. What decides
               which is unknown, and may be the caster's intent.",
      note: "Fan-named sigil. The ambiguity is canon's, not ours.",
    ),
    (
      id: "smoke_screen",
      category: "Fire",
      confidence: Unknown,
      sigil: "smoke",
      signs: [("billow", Center), ("dispersion", Around)],
      effect: "Makes smoke and spreads it. Whether the sigil can also
