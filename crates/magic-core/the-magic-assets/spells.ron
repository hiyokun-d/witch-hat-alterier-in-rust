    ),
    (
      id: "sandserpent",
      category: "Earth",
      confidence: Inferred,
      sigil: "earth",
      signs: [("weave", SurroundsSigil), ("puppet", Around)],
      effect: "Sand drawn into a long ribbon the caster steers by mind.",
      note: "Dancing puppets is one of only two signs steered by thought; the
