// Signs (keystones) — the "how" of a spell. Japanese suffix: 矢 (ya), "arrow".
//
// The naming is a gift: sigils are 紋 (mon, a crest) and signs are 矢 (ya, an
// arrow). Sigils are things; signs are vectors. Our type system should
// reflect that — every sign carries an orientation, most sigils don't.
//
// The wiki reports 44 signs deciphered so far, and groups them into four
// classes. Those class names are the wiki's own analysis, NOT stated in the
// manga — but they are mechanically useful, so we keep them and mark them.
//
// class:
//   Directional      bilateral symmetry, no radial symmetry — orientation
//                    fully determines behaviour
//   SemiDirectional  orientation matters but less strictly
//   NonDirectional   orientation irrelevant
//   Asymmetric       neither symmetry; unusual behaviour
//
// tier:
//   Official     named in the source material
//   Unofficial   fan-reconstructed name, effect inferred by spell comparison
//   Decorative   no mechanical effect

(
  signs: [
    // ---- OFFICIAL -------------------------------------------------------
    (
      id: "column",
      jp: "柱の矢",
      romaji: "hashira no ya",
      tier: Official,
      class: Directional,
      note: "Magic manifests as a column or beam above the seal. If signs are
             unbalanced the spell manifests toward the side with the most OR
             THE LARGEST signs — size counts, not just count. Longer line
             typically faces inward.",
      confidence: Canon,
      seen_in: ["watershot_seal"],
    ),
    (
      id: "dispersion",
      tier: Official,
      class: Directional,
      note: "A column that leaks in every direction instead of beaming. Same
             family of behaviour as column, different distribution.",
      confidence: Canon,
    ),
    (
      id: "levitation",
      tier: Official,
      class: Directional,
      note: "Magic floats above the seal, or moves the object the seal is
             drawn on. Movement follows where the signs point. Arrow side
             typically faces inward.",
      confidence: Canon,
      seen_in: ["pyreball_seal", "rising_platform_of_water", "sylph_shoes_seal",
                "glowstone_path", "pegasus_carriage"],
    ),
    (
      id: "pulling",
      jp: "引き寄せの矢",
      romaji: "hikiyose no ya",
      tier: Official,
      class: Directional,
      // ENGINE NOTE: this is the most precisely specified sign in canon and
      // it gives us a continuous parameter, not a binary. Angle determines
      // the pull/twist mix:
      //   arrow inward, 0°   -> pure pull
      //   arrow inward, angled -> pull + twist
      //   rotated 90°        -> pure twist, no pull
      //   inverted           -> likely push
      // Implement as: pull_strength = cos(angle), twist_strength = sin(angle)
      angle_semantics: PullTwistMix,
      note: "Pulls matter matching the seal's sigil toward the seal.",
      confidence: Canon,
      seen_in: ["flame_burst", "water_cage", "wall_bend", "grasping_wind"],
    ),
    (
      id: "crushing",
      jp: "破砕の矢",
      romaji: "hasai no ya",
      tier: Official,
      class: SemiDirectional,
      reversible: true,
      note: "Breaks things apart; reversed, reassembles them. Only ever seen
             paired with earth, so other pairings are undefined.",
      confidence: Canon,
      seen_in: ["wall_breaker_seal", "integration"],
    ),
    (
      id: "float",
      tier: Official,
      class: NonDirectional,
      note: "Makes the object it is drawn on float regardless of gravity.
             Partly retconned into levitation; surviving uses are float-only.",
      confidence: Canon,
      seen_in: ["floating_expansion", "dancing_lights"],
    ),
    (
      id: "region",
      tier: Official,
      class: Directional,
      // ENGINE NOTE: region is evaluated COLLECTIVELY across all region signs
      // in the seal, not per-sign. Four canon arrangements:
      arrangements: [
        (pattern: AllSameSide,  effect: "magic shoots that direction"),
        (pattern: AllInward,    effect: "manifests only inside the ring"),
        (pattern: AllOutward,   effect: "manifests only outside the ring, no
                                         effect within the seal"),
        (pattern: Opposed,      effect: "manifests only ON the ring itself"),
      ],
      note: "Determines WHERE magic manifests relative to the seal. Formerly
             called 'direction' on the older wiki — region is the current
             name.",
      confidence: Canon,
      seen_in: ["water_bolt", "floating_drops", "twinned_bottles"],
    ),
    (
      id: "convergence",
      tier: Official,
      class: SemiDirectional,
      note: "Focuses magic to a single point. Also makes loose particles rigid
             and compact — the apprentices used it to harden the sand in
             serpent's bed of sand. One triangle point usually faces inward.",
      confidence: Canon,
      seen_in: ["serpents_bed_of_sand", "twinned_bottles"],
    ),
    (
      id: "collection",
      tier: Official,
      class: SemiDirectional,
      note: "Collects material — and possibly magic — from above and around
             the seal for the spell to use. Open side faces inward. This is
             the sign that lets non-creating sigils (earth, wind) do anything
             at all.",
      confidence: Canon,
      seen_in: ["billowing_collection", "serpents_bed_of_sand"],
    ),
    (
      id: "billow",
      tier: Official,
      class: NonDirectional,
      can_substitute_as_sigil: true,
      requires: ["collection"],
      note: "Converts material into cloud. Needs collection to gather the
             material first. Some materials cannot be converted.",
      confidence: Canon,
    ),
    // "As of the bonus from Volume 12, the status of repetition has been
    // retconned from that of a sign to a sigil." It lives in sigils.ron.
    (
      id: "weave",
      tier: Official,
      class: NonDirectional,
      placement: SurroundsSigil,
      note: "Turns solid objects into long flexible ribbons on contact.
             Invented in-story by Richeh — proof the system permits new signs.",
      confidence: Canon,
      seen_in: ["boulder_stretch_rope"],
    ),

    // Named in the source, effects not yet documented. Model them, give them
    // no behaviour, and do NOT invent one.
    ( id: "cool",             tier: Official, confidence: Inferred,
      class: NonDirectional,
      note: "Cools things down." ),
    ( id: "strengthen",       tier: Official, confidence: Inferred,
      note: "Empowerment. Makes objects stronger, harder, more durable." ),
    ( id: "sights_set",       tier: Official, confidence: Inferred,
      class: Directional,
      note: "Focus. Aims the spell at a point or target. One of only two signs
             steered by the caster's mind, the other being puppet." ),
    ( id: "entwine",          tier: Official, confidence: Inferred,
      class: SemiDirectional,
      note: "Makes the object it is drawn on wrap around other objects." ),
    ( id: "sign_of_wind",     tier: Official, confidence: Unknown,
      class: Asymmetric,
      note: "Spiraling Winds. Once served as a wind sigil outright in chapter
             1; reaffirmed as canon by the volume 12 bonus. Function beyond
             'related to wind' is unclear." ),
    ( id: "aeriforms_defined",tier: Official, confidence: Unknown,
      class: SemiDirectional,
      note: "Name and design conflict — it looks like the wind sigil's
             modifiers but shares a name with the aeriforms sigil. Known to
             modify wind underfoot." ),
    ( id: "glaives",          tier: Official, confidence: Canon,
      class: SemiDirectional,
      note: "Determines how deeply magic embeds into flesh. Two things make it
             unlike every other sign. Engendale says glaives are not
             technically signs at all but an older technique predating the Day
             of the Pact — the Magic page calls them neither sign nor sigil.
             And they are the only mark that may be drawn OUTSIDE the ring, so
             long as they still connect to it, which is a real exception to
             canon rule 1." ),

    // ---- UNOFFICIAL -----------------------------------------------------
    (
      id: "selection",
      tier: Unofficial,
      class: NonDirectional,
      scope: SelfOnly,
      note: "Restricts the spell to affecting only the object it is drawn on.
             Isolated by comparing floating expansion against spell of
             reduction.",
      confidence: Inferred,
    ),
    (
      id: "diamond",
      tier: Unofficial,
      class: NonDirectional,
      scope: NearbyOnly,
      note: "Restricts the spell to nearby objects, excluding the object it is
             drawn on. The exact complement of window.",
      confidence: Inferred,
    ),
    (
      id: "enlarge",
      tier: Unofficial,
      class: NonDirectional,
      reversible: true,
      placement: Center,
      requires_one_of: ["selection", "diamond"],
      note: "Grows objects (corners out) or shrinks them (corners in). Window
             vs diamond decides self vs nearby.",
      confidence: Inferred,
      seen_in: ["floating_expansion", "spell_of_reduction"],
    ),
    (
      id: "crosshair",
      tier: Unofficial,
      confidence: Unknown,
      note: "From rainflinger. Three candidate functions: erase things of the
             same magic aspect, restrict manifestation to inside matching
             objects, or define an area of effect.",
    ),
    (
      id: "radial",
      tier: Unofficial,
      class: NonDirectional,
      note: "Likely weakens the spell — turns fire into gentle heat. A
             damping coefficient, effectively.",
      confidence: Inferred,
      seen_in: ["snugstone_spell"],
    ),
    (
      id: "bolt",
      tier: Unofficial,
      class: NonDirectional,
      pairs_with: ["region"],
      note: "Manifests magic as discrete bolt-like projectiles. Paired with
             region to aim it, the projectiles fire at dangerous speed.",
      confidence: Inferred,
      seen_in: ["water_bolt"],
    ),
    (
      id: "eye",
      tier: Unofficial,
      confidence: Unknown,
      pairs_with: ["vision"],
      note: "Never seen alone, so its solo effect is unknown. With vision,
             relates to illusion and light manipulation.",
      seen_in: ["gathering_shadows", "makeover_mask", "mirror_mantle"],
    ),
    (
      id: "vision",
      tier: Unofficial,
      can_substitute_as_sigil: true,
      note: "Relates to sight and visual perception. WITH eye: creates
             illusions. WITHOUT eye: aids sight (Qifrey's glasses). Same sign,
             two behaviours depending on company — a real compositional rule.",
      confidence: Inferred,
    ),
    (
      id: "bend",
      tier: Unofficial,
      confidence: Unknown,
      note: "Appears in gathering shadows, petrification, possibly wall bend.
             Common theme across all three is bending or altering reality —
             vision, physical objects, or reality itself.",
    ),
    (
      id: "rain",
      tier: Unofficial,
      class: NonDirectional,
      placement: SurroundsSigil,
      note: "Produces the sigil's magic as rainfall over the immediate area.
             Wiki speculates fire or light would give firework-like effects,
             and fire + earth might rain lava — speculation, not canon.",
      confidence: Inferred,
    ),
    (
      id: "puppet",
      tier: Unofficial,
      class: Asymmetric,
      note: "Lets a user control the movement of the object the seal is drawn
             on, apparently by mind. Movement type depends on the sigil —
             wind puppet spells only move through air. Formerly listed as
             'dancing puppet'.",
      confidence: Inferred,
      seen_in: ["flying_puppet_of_diversion", "cloak_spell", "sealchair"],
    ),
    (
      id: "orb",
      tier: Unofficial,
      class: NonDirectional,
      note: "Makes a spherical space above the seal in which the material the
             spell controls collects. Material only gathers there if added
             directly, and fills bottom-up under gravity like a cup.",
      confidence: Inferred,
      seen_in: ["water_orb"],
    ),
    (
      id: "link",
      tier: Unofficial,
      class: SemiDirectional,
      note: "Links magic between the object it is drawn on and every other
             object broken off, removed from, or made out of the same original
             — the split-shard bangles are rings cut from one crystal. What
             link does paired with anything but weave is unknown.",
      confidence: Inferred,
      seen_in: ["light_tracer"],
    ),
    (
      id: "purify",
      tier: Unofficial,
      class: Asymmetric,
      note: "Separates impurities out of the sigil's magic — particulates from
             water, dust from air.",
      confidence: Inferred,
      seen_in: ["purify", "sewer_grate"],
    ),
    (
      id: "stillness",
      tier: Unofficial,
      note: "Holds a magical effect static in one place. Reasoned from
             snowfending, where it likely pins heat over the house.",
      confidence: Inferred,
      seen_in: ["snowfending"],
    ),
    (
      id: "projection",
      tier: Unofficial,
      note: "Projects an effect outward, likely only images the spell names.",
      confidence: Inferred,
      seen_in: ["mirror_cloak_spell", "mirror_spell"],
    ),
    (
      id: "launch",
      tier: Unofficial,
      class: Directional,
      note: "Generates the target in the direction it points, in a powerful
             but short-lived burst — far enough to clear trees, then spent,
             leaving behind whatever else the seal generated.",
      confidence: Inferred,
      seen_in: ["ancient_light_beacon", "bird_of_light_beacon"],
    ),


    // ---- OFFICIAL, added after reading Signs Explained first-hand ---------
    (
      id: "bind",
      tier: Official,
      jp: "留める矢",
      note: "Binding. Halts the movement of the target material and binds it
             together, so it acts and is moved as a single unit.",
      confidence: Inferred,
      seen_in: ["raincleaver_spell", "sand_bridge"],
    ),
    (
      id: "stability",
      tier: Official,
      class: NonDirectional,
      can_substitute_as_sigil: true,
      note: "Stability and Level Planes. Balances the target in a plane in the
             air — like a float on water, free to turn and drift but always on
             top. No known difference between the two- and three-lined
             versions. Can take the place of a sigil.",
      confidence: Canon,
      seen_in: ["earth_lift", "fish_guidance", "pouch_guidance",
                "floatglow_lamp_seal", "glowstone_path_seal",
                "pegasus_carriage_spell", "seal_of_expansion_and_levitation",
                "snowfending", "wayward_whorlwind"],
    ),
    (
      id: "coil",
      tier: Official,
      class: NonDirectional,
      reversible: false,
      note: "Makes physical matter manifest in a spring or coil. Solids only —
             no effect on liquids or gases.",
      confidence: Inferred,
    ),
    (
      id: "gathering",
      tier: Official,
      jp: "集める矢",
      romaji: "atsumeru ya",
      class: SemiDirectional,
      note: "Close to collection in design and function: lets a spell build its
             effect from surrounding material. May be the less passive of the
             two, actively drawing material in rather than taking what is
             near. Never seen inverted.",
      confidence: Inferred,
      seen_in: ["raincleaver_spell", "vapor_bubble_spell", "wayward_whorlwind"],
    ),
    (
      id: "solidification",
      tier: Official,
      jp: "凝固の矢",
      note: "Makes magic drawn within or connecting to it more solid. Can be
             written alone or with signs, sigils or seals inside one of its
             circles, to the same effect. Told apart from a linked seal by its
             straight lines and by the seal it links to being empty.",
      confidence: Inferred,
      seen_in: ["raincleaver_spell", "sand_bridge"],
    ),
    (
      id: "envelopment",
      tier: Official,
      jp: "衣まといの矢",
      note: "Makes an effect envelop or surround what it targets.",
      confidence: Inferred,
      seen_in: ["beldaruits_illusion_cloak_spell", "borrowshade",
                "mirror_cloak_spell", "petrification", "raincleaver_spell",
                "sasarans_cloak_spell"],
    ),
    (
      id: "concealment",
      tier: Official,
      jp: "覆いの矢",
      romaji: "ooi no ya",
      note: "Hides a target object. Named by Euini examining the Mirror Cloak
             of Borrowshade, where it conceals the wearer in shadow.",
      confidence: Canon,
      seen_in: ["borrowshade", "looking_glass", "makeover_mask_spell",
                "mirror_cloak_spell", "sasarans_cloak_spell"],
    ),
    (
      id: "reflection",
      tier: Official,
      jp: "反射の矢",
      romaji: "hansha no ya",
      note: "Targets a reflected image found on the object the casting seal is
             drawn on — the Mirror Cloak draws on a beast reflected in its own
             scales.",
      confidence: Inferred,
      seen_in: ["mirror_cloak_spell", "mirror_spell"],
    ),
    (
      id: "windows",
      tier: Official,
      placement: SurroundsSigil,
      note: "Connects two spaces that are not physically joined — a portal.
             Drawn unlike any other sign: it lines the seal as an additional
             ring with several identical small marks inside it, rather than
             sitting beside the sigil. Many variants, one per Windowway.
             NOTE: not to be confused with `selection`, which this project
             previously called `window`.",
      confidence: Canon,
      seen_in: ["doorknob_determined_destination_doorway", "handheld_windowway",
                "sasarans_cloak_spell", "windowway_spell"],
    ),

    // ---- DECORATIVE -----------------------------------------------------
    //
    // Empty, and it stays empty. What used to live here — bird, the Zozah
    // animal shapes — were retconned from decorative *signs* to decorative
    // *sigils* in Chapter 78, and now live in sigils.ron with real effects
    // (sculpt, target, restrict). There is no decorative tier of signs.
  ],
)
